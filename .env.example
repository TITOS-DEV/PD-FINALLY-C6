# Copy this file to .env at the repo root and fill in the real values.
# `docker compose up` reads this file directly; running the API locally
# with `pnpm dev` also finds it here (see apps/api/src/infrastructure/config/env.ts).

# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Use the "Session pooler" mode, NOT "Direct connection" and NOT
# "Transaction pooler":
#   - Direct connection (db.<ref>.supabase.co) only has an IPv6 address
#     unless you pay for Supabase's IPv4 add-on — most home/CI/Docker
#     networks can't reach it at all and you'll see ENETUNREACH.
#   - Session pooler (aws-0-<region>.pooler.supabase.com:5432) is IPv4 and
#     behaves exactly like a direct connection (full session state, so our
#     BEGIN / set_config / SET LOCAL ROLE / ... / COMMIT trick for RLS works
#     unchanged) — see DECISIONS.md for why we need that.
#   - Transaction pooler (same host, port 6543) is IPv4 too but rotates the
#     underlying connection between statements in ways that fight prepared
#     statements — avoid it here.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# ---- JWT ----
# Any long random string works; e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI provider (swappable — see infrastructure/ai/AIProviderFactory.ts) ----
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Only needed if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- CORS ----
# El frontend (apps/web) corre en el puerto 4200 por defecto, tanto con
# `ng serve` local como con `docker compose up`. Esta variable también
# controla el CORS de Socket.io (ver socketServer.ts), no solo el de Express.
CORS_ORIGIN=http://localhost:4200
